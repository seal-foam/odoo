<odoo>
    <template id="report_mrporder" inherit_id="mrp.report_mrporder">
        <xpath expr="//span[@t-field='o.date_deadline']/.." position="before">
            <div class="col-3">
                <strong>Fecha de creación:</strong>
                <br/>
                <span t-field="o.create_date"/>
            </div>
            <div class="col-3" t-if="o.date_finished">
                <strong>Fecha de finalización:</strong>
                <br/>
                <span t-field="o.date_finished"/>
            </div>
            <div class="col-3" t-if="o.effective_date">
                <strong>Fecha de transferencia:</strong>
                <br/>
                <span t-field="o.effective_date"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='mrp.report_mrp_production_components']" position="after">
            <div style="page-break-before:always;"/>
            <t t-call="drs_mrp.mrp_empty_tables"/>
        </xpath>
    </template>
    <template id="mrp_empty_tables">
        <table class="table table-borderless mb-1" style="font-size:11px;">
            <tr>
                <td class="fw-bold">
                    PROCESO DE ADHESIVADO Y /O CORTE
                </td>
                <td></td>
                <td></td>
                <td></td>
            </tr>

            <tr>
                <td>
                    <strong>Número de operador:</strong>
                </td>

                <td>
                    <strong>Número de auxiliar de operador:</strong>
                </td>

                <td>
                    <strong>Ancho de bandas:</strong>
                    <br/>
                    Cantidad de bandas:
                </td>

                <td>
                    <strong>Cantidad y ancho de bandas sobrantes:</strong>
                </td>
            </tr>
        </table>
        <table class="table table-sm table-bordered text-center align-middle"
               style="width:100%; table-layout:fixed; font-size:10px;">
            <thead class="table-light">
                <tr>
                    <th style="width:6%;">Fecha</th>
                    <th style="width:8%;" class="text-wrap">
                        Hora de inicio ajuste de máquina
                    </th>
                    <th style="width:8%;" class="text-wrap">
                        Hora de termino ajuste de máquina
                    </th>
                    <th style="width:8%;" class="text-wrap">
                        Merma de ajuste de máquina (centímetros)
                    </th>
                    <th style="width:7%;" class="text-wrap">
                        Hora inicio de corrida
                    </th>
                    <th style="width:7%;" class="text-wrap">
                        Hora termino de corrida
                    </th>
                    <th style="width:7%;" class="text-wrap">
                        Cantidad producida rollos
                    </th>
                    <th style="width:10%;" class="text-wrap">
                        Cantidad producida metros lineales
                    </th>
                    <th style="width:7%;" class="text-wrap">
                        Cantidad de Scrap (centímetros)
                    </th>
                    <th style="width:10%;" class="text-wrap">
                        Descripción del Scrap
                    </th>
                    <th style="width:10%;" class="text-wrap">
                        Tiempo de paro (minutos)
                    </th>
                    <th style="width:12%;" class="text-wrap">
                        Motivo de paro
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="range(6)" t-as="i">
                    <tr style="height:28px;">
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td class="text-start"/>
                        <td/>
                        <td class="text-start"/>
                    </tr>
                </t>
            </tbody>
        </table>
        <div style="margin-top:18px; font-size:10px;">
            <strong>
                Motivo del porqué se fabricó una cantidad diferente a la especificada en MO:
            </strong>
            <div style="border-bottom:1px solid #000; height:22px;"/>
            <div style="border-bottom:1px solid #000; height:22px;"/>
        </div>
        <table class="table table-borderless mb-1" style="width:100%; font-size:11px;">
            <tr>
                <td colspan="3" class="fw-bold">
                    PROCESO DE SUAJADO/MANUFACTURA
                </td>
            </tr>
            <tr>
                <td style="width:33%">
                    <strong>Número de operador:</strong>
                </td>
                <td style="width:33%">
                    <strong>Número de auxiliar de operador:</strong>
                </td>
                <td style="width:34%">
                    <strong>No. Cavidades suaje:</strong>
                </td>
            </tr>
        </table>
        <table class="table table-sm table-bordered text-center align-middle"
               style="width:100%; table-layout:fixed; font-size:10px;">
            <thead class="table-light">
                <tr>
                    <th style="width:6%">Fecha</th>
                    <th style="width:8%" class="text-wrap">
                        Hora de inicio ajuste de máquina
                    </th>
                    <th style="width:8%" class="text-wrap">
                        Hora de termino ajuste de máquina
                    </th>
                    <th style="width:9%" class="text-wrap">
                        Merma de ajuste de máquina (piezas)
                    </th>
                    <th style="width:6%" class="text-wrap">
                        Hora inicio de corrida
                    </th>
                    <th style="width:6%" class="text-wrap">
                        Hora termino de corrida
                    </th>
                    <th style="width:8%" class="text-wrap">
                        Cantidad producida (piezas)
                    </th>
                    <th style="width:8%" class="text-wrap">
                        Cantidad de Scrap (piezas)
                    </th>
                    <th style="width:20%" class="text-wrap">
                        Descripción del Scrap
                    </th>
                    <th style="width:6%" class="text-wrap">
                        Tiempo de paro (minutos)
                    </th>
                    <th style="width:15%" class="text-wrap">
                        Motivo de paro
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="range(6)" t-as="i">
                    <tr style="height:30px;">
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td class="text-start"/>
                        <td/>
                        <td class="text-start"/>
                    </tr>
                </t>
            </tbody>
        </table>
        <div style="margin-top:18px; font-size:10px;">
            <strong>
                Motivo del porqué se fabricó una cantidad diferente a la especificada en MO:
            </strong>
            <div style="border-bottom:1px solid #000; height:22px;"/>
            <div style="border-bottom:1px solid #000; height:22px;"/>
        </div>
        <table class="table table-borderless mb-1" style="width:100%; font-size:11px;">
            <tr>
                <td class="fw-bold">
                    PROCESO DE DESTROQUELADO
                </td>
            </tr>
            <tr>
                <td>
                    <strong>Número de operador(es):</strong>
                </td>
            </tr>
        </table>
        <table class="table table-sm table-bordered text-center align-middle"
               style="width:100%; table-layout:fixed; font-size:10px;">
            <thead class="table-light">
                <tr>
                    <th style="width:15%" class="text-wrap">
                        Fecha de recibo
                    </th>
                    <th style="width:15%" class="text-wrap">
                        Fecha de entrega
                    </th>
                    <th style="width:15%" class="text-wrap">
                        Cantidad producida (piezas)
                    </th>
                    <th style="width:15%" class="text-wrap">
                        Cantidad SCRAP (piezas)
                    </th>
                    <th style="width:40%" class="text-wrap">
                        Descripción del SCRAP
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="range(5)" t-as="i">
                    <tr style="height:30px; page-break-inside:avoid;">
                        <td/>
                        <td/>
                        <td/>
                        <td/>
                        <td class="text-start"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
</odoo>