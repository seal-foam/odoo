<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_uom_no_open" model="ir.ui.view">
        <field name="name">product.template.form.uom.no.open</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']//field[@name='uom_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']//field[@name='uom_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_open': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
